{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/spec",
    "moduleResolution": "bundler",
    "types": ["vitest/globals", "node"],
    "noImplicitAny": false
  },
  "files": ["vitestSetup.ts", "src/schematics/test-setup.ts"],
  "include": [
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "src/**/*.d.ts",
    "demo/src/**/*.spec.ts",
    "demo/src/**/*.test.ts",
    "demo/src/**/*.d.ts",
    "integration/ssr/src/**/*.spec.ts",
    "integration/ssr/src/**/*.test.ts",
    "integration/ssr/src/**/*.d.ts"
  ]
}
