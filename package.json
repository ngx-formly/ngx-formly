{
  "name": "@ngx-formly/common",
  "version": "11.0.0",
  "packageManager": "npm@11.19.0",
  "author": "Zama Khan Mohammed <mohammedzamakhan@gmail.com>",
  "contributors": [
    "Zama Khan Mohammed <mohammedzamakhan@gmail.com>",
    "Kent C. Dodds <kent@doddsfamily.us>"
  ],
  "scripts": {
    "contrib:generate": "githubcontrib --owner ngx-formly --repo ngx-formly --cols 8 --sortOrder desc > CONTRIBUTORS.md",
    "lint": "eslint --ext=.ts,.html src/ demo/ --cache --cache-location=node_modules/.cache/.eslintcache",
    "lint:fix": "eslint --ext=.ts,.html src/ demo/ --fix --cache --cache-location=node_modules/.cache/.eslintcache",
    "format": "prettier --list-different \"**/*.{ts,json,css,scss,html}\" --cache",
    "format:fix": "prettier --write \"**/*.{ts,json,css,scss,html}\" --cache",
    "commit": "git-cz",
    "build": "ts-node --dir build build.ts",
    "release": "standard-version",
    "publish": "ts-node --dir build publish.ts",
    "start": "ng serve app --port 4100 --open",
    "demo": "npm run start",
    "docs:api": "node build/docs.mjs",
    "docs:check": "node build/docs.mjs --check && node --test build/docs.test.mjs",
    "docs:build": "npm run docs:api && ng build app --configuration production",
    "prestart": "npm run docs:api",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "github-release": "conventional-github-releaser -p angular --draft",
    "e2e:ssr": "ng build ssr --configuration production && (PORT=4200 node integration/ssr/dist/server/server.mjs & pid=$!; trap 'kill $pid' EXIT; cypress run)",
    "prepare": "husky install"
  },
  "keywords": [
    "angular",
    "forms",
    "ngx-formly",
    "formly",
    "angular forms",
    "json forms",
    "dynamic forms",
    "form library"
  ],
  "license": "MIT",
  "description": "Formly is a dynamic (JSON powered) form library for Angular that bring unmatched maintainability to your application's forms.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ngx-formly/ngx-formly.git"
  },
  "bugs": {
    "url": "https://github.com/ngx-formly/ngx-formly/issues"
  },
  "homepage": "https://github.com/ngx-formly/ngx-formly#readme",
  "dependencies": {
    "@angular/animations": "^22.2.2",
    "@angular/cdk": "^22.2.2",
    "@angular/common": "^22.2.2",
    "@angular/core": "^22.2.2",
    "@angular/forms": "^22.2.2",
    "@angular/localize": "^22.2.2",
    "@angular/material": "^22.2.2",
    "@angular/platform-browser": "^22.2.2",
    "@angular/platform-browser-dynamic": "^22.2.2",
    "@angular/platform-server": "^22.2.2",
    "@angular/router": "^22.2.2",
    "@angular/ssr": "^22.2.2",
    "@ctrl/tinycolor": "^4.1.0",
    "@ionic/angular": "^9.0.7",
    "@nativescript/angular": "^22.0.1",
    "@nativescript/core": "^8.3.0",
    "@ng-bootstrap/ng-bootstrap": "^21.0.0",
    "@ngx-loading-bar/core": "^7.0.0",
    "@ngx-loading-bar/router": "^7.0.0",
    "@ngx-translate/core": "^16.0.4",
    "@ngx-translate/http-loader": "^16.0.1",
    "@primeuix/themes": "^2.0.2",
    "@progress/kendo-angular-common": "^25.3.0",
    "@progress/kendo-angular-dateinputs": "^25.3.0",
    "@progress/kendo-angular-dropdowns": "^25.3.0",
    "@progress/kendo-angular-inputs": "^25.3.0",
    "@progress/kendo-angular-intl": "^25.3.0",
    "@progress/kendo-angular-l10n": "^25.3.0",
    "@progress/kendo-angular-label": "^25.3.0",
    "@progress/kendo-angular-popup": "^25.3.0",
    "@progress/kendo-angular-treeview": "^25.3.0",
    "@progress/kendo-drawing": "^1.25.0",
    "@progress/kendo-licensing": "^1.11.0",
    "@progress/kendo-theme-default": "^14.6.1",
    "@stackblitz/sdk": "^1.8.0",
    "ag-grid-angular": "^33.1.0",
    "ag-grid-community": "^33.1.0",
    "bootstrap": "^5.1.3",
    "core-js": "^3.23.4",
    "express": "^4.18.1",
    "marked": "^4.3.0",
    "ng-zorro-antd": "^22.1.2",
    "primeflex": "^3.2.1",
    "primeicons": "^7.0.0",
    "primeng": "^22.1.2",
    "rxjs": "^7.8.1",
    "tslib": "^2.4.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.8.1",
    "@angular-devkit/core": "^22.2.2",
    "@angular-devkit/schematics": "^22.2.2",
    "@angular-eslint/builder": "^22.6.0",
    "@angular-eslint/eslint-plugin": "^22.6.0",
    "@angular-eslint/eslint-plugin-template": "^22.6.0",
    "@angular-eslint/schematics": "^22.6.0",
    "@angular-eslint/template-parser": "^22.6.0",
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler": "^22.2.2",
    "@angular/compiler-cli": "^22.2.2",
    "@angular/language-service": "^22.2.2",
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-angular": "^19.5.0",
    "@schematics/angular": "^22.2.2",
    "@types/express": "^5.0.0",
    "@types/json-schema": "^7.0.11",
    "@types/marked": "^4.3.2",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "@vitest/coverage-v8": "^4.1.11",
    "angular-eslint": "^22.6.0",
    "browser-sync": "^3.0.0",
    "commitizen": "^4.2.3",
    "conventional-github-releaser": "^3.1.5",
    "cypress": "^15.21.1",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.0.0",
    "github-contributors-list": "^1.2.4",
    "happy-dom": "^20.14.5",
    "highlight.js": "^11.6.0",
    "html-loader": "^5.1.0",
    "husky": "^9.1.6",
    "istanbul-lib-instrument": "^6.0.3",
    "json-formatter-js": "^2.3.4",
    "lint-staged": "^15.5.2",
    "ng-packagr": "^22.2.4",
    "prettier": "^3.3.3",
    "standard-version": "^9.5.0",
    "ts-loader": "^9.3.1",
    "ts-node": "^10.9.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.11",
    "webpack": "^5.73.0",
    "zone.js": "^0.15.1"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "lint-staged": {
    "*.{ts,html}": "eslint --cache --fix --cache-location=node_modules/.cache/.eslintcache",
    "*.{ts,json,css,scss,html}": "prettier --cache --write"
  },
  "bundlesize": [
    {
      "path": "./dist/@ngx-formly/core/fesm2022/ngx-formly-core-*.mjs",
      "maxSize": "8 kB"
    },
    {
      "path": "./dist/@ngx-formly/bootstrap/fesm2022/ngx-formly-bootstrap-*.mjs",
      "maxSize": "4 kB"
    },
    {
      "path": "./dist/@ngx-formly/material/fesm2022/ngx-formly-material-*.mjs",
      "maxSize": "7 kB"
    },
    {
      "path": "./dist/@ngx-formly/ionic/fesm2022/ngx-formly-ionic-*.mjs",
      "maxSize": "4 kB"
    },
    {
      "path": "./dist/@ngx-formly/primeng/fesm2022/ngx-formly-primeng-*.mjs",
      "maxSize": "4 kB"
    },
    {
      "path": "./dist/@ngx-formly/kendo/fesm2022/ngx-formly-kendo-*.mjs",
      "maxSize": "4 kB"
    },
    {
      "path": "./dist/@ngx-formly/nativescript/fesm2022/ngx-formly-nativescript-*.mjs",
      "maxSize": "4 kB"
    },
    {
      "path": "./dist/@ngx-formly/ng-zorro-antd/fesm2022/ngx-formly-ng-zorro-antd-*.mjs",
      "maxSize": "4 kB"
    }
  ]
}
