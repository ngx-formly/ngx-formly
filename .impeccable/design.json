      "css": ".ds-field{font:400 16px/1.6 Roboto,sans-serif}.ds-field-label{display:inline-block;margin-bottom:.5rem}.ds-field-input{display:block;width:calc(100% - 1.5rem - 2px);padding:.375rem .75rem;font:400 1rem/1.5 Roboto,sans-serif;color:var(--bs-body-color,#212529);background:var(--bs-body-bg,#fff);border:1px solid var(--bs-border-color,#dee2e6);border-radius:var(--bs-border-radius,.375rem);transition:border-color .15s ease-in-out,box-shadow .15s ease-in-out}.ds-field-input:focus,.ds-field-input:focus-visible{border-color:#86b7fe;outline:0;box-shadow:0 0 0 .25rem rgba(13,110,253,.25)}.ds-field-input:disabled{background:var(--bs-secondary-bg,#e9ecef)}@media(prefers-reduced-motion:reduce){.ds-field-input{transition:none}}"
