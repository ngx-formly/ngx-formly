  "narrative": {
    "northStar": "angular.dev documentation reference",
    "overview": "The user pinned [angular.dev](https://angular.dev/) as the visual reference. Formly keeps its name and logo, with a compact navigation rail, Inter Tight headings, and a restrained magenta accent. The homepage uses a dark introduction and a working configuration-to-form example. Guides use a white reading area beside a pale section sidebar.\n\nThis system covers the website around the examples. The forms inside examples keep their UI adapter's controls, validation, and interaction states. The source files are the authority for implementation; the tokens above record their reusable values. Page composition and intent remain in the [homepage brief](.impeccable/surfaces/demo-src-app-home-component-ts.md) and [documentation brief](.impeccable/surfaces/demo-src-app-app-component-ts.md).",
    "keyCharacteristics": [
      "Inter Tight headings with Roboto body text.",
      "Thin borders and pale backgrounds separate navigation, code, and forms.",
      "A near-black homepage introduction with pale pink actions.",
      "Runnable examples retain the appearance of their selected UI library.",
      "System, Dark, and Light themes selected from the navigation rail or mobile header; the browser remembers the preference."
    ],
    "rules": [
      {
        "name": "The Contextual Accent Rule",
        "body": "Use magenta for links and navigation on light backgrounds and pale pink on dark backgrounds. Adapter control colors remain owned by their UI library.",
        "section": "colors"
      },
      {
        "name": "The Heading Weight Rule",
        "body": "Use the shipped Inter Tight medium face for website headings. Keep the adapter's own typography inside runnable forms.",
        "section": "typography"
      },
      {
        "name": "The Bordered Container Rule",
        "body": "Separate website code, navigation, and example areas with the shared line color and background tones. Use the existing UI library for overlay and control elevation.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use the shared website colors for navigation, documentation, and example containers.",
      "Do preserve the Formly name and logo.",
      "Do use Inter Tight medium for website headings and Roboto for body copy.",
      "Do keep form controls and their states faithful to the selected UI adapter.",
      "Do keep code selectable, allow horizontal scrolling, and preserve visible keyboard focus.",
      "Do preserve authored embed heights except for the responsive YouTube treatment."
    ],
    "donts": [
      "Don't apply homepage display sizing or dark hero colors to guide body content.",
      "Don't turn the website's magenta accent into a global override of adapter controls.",
      "Don't remove labels, validation messages, required markers, or accessible action names to simplify a preview.",
      "Don't add shadows to the website's bordered code and example containers."
    ]
  }
}
